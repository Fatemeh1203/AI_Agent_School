      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\n// TODO: وقتی دامنه‌ی سایت مدرسه مشخص شد، allowedOrigins در نود «دریافت پیام وب»\n// از \"*\" به همان دامنه محدود شود.\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) staticData.rateLimits = {};\n\nconst item = $input.first().json;\nconst body = item.body || {};\nconst headers = item.headers || {};\nconst ipHeader = headers['x-forwarded-for'] || headers['x-real-ip'] || '';\nconst ip = String(ipHeader).split(',')[0].trim() || 'unknown';\n\nconst now = Date.now();\nconst WINDOW_MS = 60 * 1000;\nconst MAX_REQ = 20; // TODO: عدد نهایی نرخ‌محدودسازی را در صورت نیاز اینجا تنظیم کنید\n\nconst bucket = staticData.rateLimits[ip] || [];\nconst recent = bucket.filter(function (t) { return now - t < WINDOW_MS; });\nrecent.push(now);\nstaticData.rateLimits[ip] = recent;\n\nif (recent.length > MAX_REQ) {\n  return [{ json: { ok: false, reason: 'rate_limited' } }];\n}\n\nconst sessionId = body.sessionId;\nconst input = body.input;\n\nif (!sessionId || typeof sessionId !== 'string' ||\n    !input || (input.type !== 'text' && input.type !== 'choice') ||\n    input.value === undefined || input.value === null) {\n  return [{ json: { ok: false, reason: 'bad_request' } }];\n}\n\nreturn [{ json: { ok: true, channel: 'web', channelUserId: sessionId, input: input } }];\n"
      }
    },
