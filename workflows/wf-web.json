      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst reason = $json.reason;\nconst map = {\n  rate_limited: { code: 429, message: 'تعداد درخواست‌های شما در این دقیقه زیاد بوده است. کمی صبر کنید و دوباره تلاش کنید.' },\n  bad_request: { code: 400, message: 'درخواست نامعتبر است.' }\n};\nconst r = map[reason] || { code: 400, message: 'درخواست نامعتبر است.' };\nreturn [{ json: { statusCode: r.code, messages: [r.message], choices: [], expectsInput: null } }];\n"
      }
