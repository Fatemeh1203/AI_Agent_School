    {
      "id": "استخراج و نرمال‌سازی رویداد",
      "name": "استخراج و نرمال‌سازی رویداد",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst item = $input.first().json;\nconst msg = item.message;\nconst cb = item.callback_query;\n\nlet updateId = item.update_id;\nlet chatId, input, callbackQueryId = null;\n\nif (cb) {\n  chatId = cb.message && cb.message.chat ? cb.message.chat.id : cb.from.id;\n  input = { type: 'choice', value: cb.data };\n  callbackQueryId = cb.id;\n} else if (msg) {\n  chatId = msg.chat.id;\n  const text = (msg.text || '').trim();\n  if (text === '/start' || text === '') {\n    input = { type: 'choice', value: 'show_menu' };\n  } else {\n    input = { type: 'text', value: text };\n  }\n} else {\n  return [];\n}\n\nreturn [{ json: {\n  updateId: updateId,\n  chatId: String(chatId),\n  input: input,\n  callbackQueryId: callbackQueryId\n} }];\n"
      }
    },
    {
      "id": "آیا کلیک روی دکمه است؟",
      "name": "آیا کلیک روی دکمه است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
