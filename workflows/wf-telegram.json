    {
      "id": "آماده‌سازی پیام‌های ارسالی",
      "name": "آماده‌سازی پیام‌های ارسالی",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst chatId = $('استخراج و نرمال‌سازی رویداد').first().json.chatId;\nconst core = $json;\nconst messages = core.messages || [];\nconst choices = core.choices || [];\n\nconst items = [];\nmessages.forEach(function (text, idx) {\n  const isLast = idx === messages.length - 1;\n  const payload = { chat_id: chatId, text: text };\n  if (isLast && choices.length) {\n    payload.reply_markup = {\n      inline_keyboard: choices.map(function (c) { return [{ text: c.label, callback_data: c.id }]; })\n    };\n  }\n  items.push({ json: payload });\n});\n\nif (items.length === 0) {\n  items.push({ json: { chat_id: chatId, text: 'پاسخی دریافت نشد.' } });\n}\n\nreturn items;\n"
      }
    },
