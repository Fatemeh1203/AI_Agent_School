# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید. .env را کامیت نکنید.

# اتصال به همان PostgreSQL سامانه (نه یک دیتابیس جدا).
# فرمت: pg://<host>:<port>?u=<user>&p=<password>&d=<database>
NC_DB=pg://localhost:5432?u=hadaf_nocodb_user&p=REPLACE_WITH_STRONG_PASSWORD&d=hadaf_school

# یک رشته‌ی تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای توکن‌های ورود NocoDB
NC_AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET
